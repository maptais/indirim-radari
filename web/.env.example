# ==============================================================================
# İndirim Radarı — Next.js iOS PWA Ortam Değişkenleri
# Bu dosyayı `web/.env.local` olarak kopyalayıp kendi değerlerinizle doldurun.
# ==============================================================================

# Supabase Public (İstemci tarafı okuma için)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only (API Route üzerinden ayar ve abonelik güncelleme için)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push / VAPID Anahtarları (Faz 3: iOS Safari Push aboneliği için)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
