# ==============================================================================
# İndirim Radarı — Python Scraper Ortam Değişkenleri
# Bu dosyayı `scraper/.env` olarak kopyalayıp kendi değerlerinizle doldurun.
# ==============================================================================

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (Faz 4: AI Tarz Puanlayıcı için)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Web Push / VAPID Anahtarları (Faz 3: iPhone bildirimleri için)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_SUB=mailto:you@example.com

# Çalışma Ayarları (Opsiyonel)
SCRAPER_RUN_MODE=cloud
REQUEST_TIMEOUT_SECONDS=20
MIN_JITTER_SECONDS=1.0
MAX_JITTER_SECONDS=3.0
LOG_LEVEL=INFO
